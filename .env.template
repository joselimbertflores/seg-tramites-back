# MONGO DATABASE URL
DATABASE_URL=mongodb://127.0.0.1:27017/dev-seg-tramites

# PORT APP
PORT=3000

# HOST FOR FILE SERVICE
HOST=http://192.168.30.34:3000

# YEAR FOR CODES GENERATION
YEAR=2025 

# BUSINESS DAYS FOR AUTO REJECT COMMUNICATIONS
AUTO_REJECT_DAYS=3

# MAIL CONFIGURATION
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=email
MAIL_PASSWORD=password

# APPLICATION AND AUTHENTICATION
NODE_ENV=development

# Public URL of this backend. OAuth callback is derived from it.
SEG_TRAMITES_PUBLIC_URL=http://localhost:3000

# Optional Angular URL when it runs on a separate origin.
# Also enables CORS for that origin and is used for UI redirects.
SEG_TRAMITES_UI_URL=http://localhost:4200

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# IDENTITY HUB
# Canonical Identity Hub URL used for OAuth, issuer and JWKS.
IDENTITY_HUB_PUBLIC_URL=http://localhost:8000

# Optional server-to-server Identity Hub base URL.
# Omit when IDENTITY_HUB_PUBLIC_URL is directly reachable.
# IDENTITY_HUB_INTERNAL_URL=http://localhost:8000

OAUTH_CLIENT_ID=seg-tramites
OAUTH_CLIENT_SECRET=

# RRHH INTERNAL EMPLOYEE DIRECTORY
RRHH_INTERNAL_URL=http://localhost:3001
RRHH_ACCESS_TOKEN=change-me
